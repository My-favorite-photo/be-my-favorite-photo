generator client {
  provider = "prisma-client"
  output   = "../../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique @db.VarChar(255)
  password     String  @db.VarChar(255)
  nickname     String  @unique @db.VarChar(50)
  refreshToken String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // 관계 설정
  point          Point?
  pointHistories PointHistory[]
  userCards      UserCard[]
  sales          Sale[]

  // 교환 관련: 내가 신청한 것 vs 내가 받은 요청
  sentTrades     Trade[] @relation("TradeApplicant")
  receivedTrades Trade[] @relation("TradeOwner")

  notifications Notification[]
  createdCards  PhotoCard[]    @relation("CardCreator") // 크리에이터인 경우

  // @@map("users")
}

model Trade {
  id          String      @id @default(cuid())
  applicantId String // 교환 신청자
  ownerId     String // 교환 대상자 (원주인)
  saleId      String
  description String? // 교환 제안 메시지
  userCardId  String
  status      TradeStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  applicant      User           @relation("TradeApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  owner          User           @relation("TradeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  userCard       UserCard       @relation(fields: [userCardId], references: [id], onDelete: Cascade)
  tradeHistories TradeHistory[] // 교환에 포함된 카드들 (양쪽 모두)
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

model PhotoCard {
  id          String    @id @default(cuid())
  creatorId   String
  name        String    @db.VarChar(100)
  imageUrl    String    @db.VarChar(2048)
  description String?   @db.Text
  // 등급과 장르는 Enum으로 관리 (성능 최적화)
  grade       CardGrade
  genre       CardGenre

  price         Int      @default(0) // 가격
  totalQuantity Int // 총 발행량
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  creator   User       @relation("CardCreator", fields: [creatorId], references: [id])
  userCards UserCard[] // 이 템플릿으로 발행된 실제 카드들
}

enum CardGrade {
  COMMON
  RARE
  SUPER_RARE
  LEGENDARY
}

enum CardGenre {
  TRAVEL
  LANDSCAPE
  PORTRAIT
  OBJECT
}

model Sale {
  id          String     @id @default(cuid())
  sellerId    String
  userCardId  String
  price       Int
  description String?    @db.Text
  status      SaleStatus @default(ON_SALE)

  grade     SaleGrade
  genre     SaleGenre
  quantity  Int // 초기 등록 수량 (예시:10장)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  seller        User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userCard      UserCard      @relation(fields: [userCardId], references: [id], onDelete: Cascade)
  trade         Trade[]
  saleHistories SaleHistory[] // 판매에 포함된 카드 목록

  @@unique([sellerId, userCardId])
}

enum SaleStatus {
  ON_SALE
  SOLD_OUT
  CANCELLED
}

enum SaleGrade {
  COMMON
  RARE
  SUPER_RARE
  LEGENDARY
}

enum SaleGenre {
  TRAVEL
  LANDSCAPE
  PORTRAIT
  OBJECT
}

model UserCard {
  id          String     @id @default(cuid())
  userId      String
  photoCardId String
  price       Int        @default(0) // 가격
  status      CardStatus @default(OWNED) // 보유중, 판매중, 교환중 등 상태 관리
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoCard     PhotoCard @relation(fields: [photoCardId], references: [id])
  totalQuantity Int
  // N:M 관계를 위한 연결
  sale          Sale[]
  trade         Trade[]
}

enum CardStatus {
  OWNED // 보유 중 (기본)
  ON_SALE // 판매 등록됨
  TRADING // 교환 진행 중
  BURNED // 소각됨 (필요 시)
}

model TradeHistory {
  id         String        @id @default(cuid())
  tradeId    String
  userCardId String
  type       TradeItemType // GIVEN(신청자가 주는 것) vs TAKEN(대상자에게 받는 것)

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

enum TradeItemType {
  OFFERED // 신청자가 제공하는 카드
  TARGET // 신청자가 원하는 상대방 카드
}

model SaleHistory {
  id         String @id @default(cuid())
  saleId     String
  userCardId String

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Point {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PointHistory {
  id          String    @id @default(cuid())
  userId      String
  amount      Int // 변동량 (+/-)
  type        PointType // 변동 사유
  description String? // 상세 설명 (예: "피카츄 카드 판매 대금")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PointType {
  JOIN_BONUS
  DAILY_CHECK_IN
  PURCHASE_REWARD
  SALE_INCOME
  BUY_SPEND
  EXCHANGE_FEE
  REFUND
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
